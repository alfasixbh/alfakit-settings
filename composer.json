{
  "name": "alfasix/alfakit-settings",
  "description": "Settings pages for Spatie Laravel Settings in AlfaKit panels.",
  "keywords": [
    "laravel",
    "alfakit",
    "settings",
    "spatie",
    "configuration"
  ],
  "homepage": "https://alfakit.dev/docs/plugins/settings",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Alfa Six",
      "homepage": "https://alfasixbh.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/alfasixbh/alfakit/issues",
    "source": "https://github.com/alfasixbh/alfakit/tree/main/packages/plugins/settings"
  },
  "require": {
    "php": "^8.3",
    "alfasix/alfakit": "^0.1|@dev",
    "spatie/laravel-settings": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "AlfaSix\\AlfakitSettings\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlfaSix\\AlfakitSettings\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AlfaSix\\AlfakitSettings\\AlfakitSettingsServiceProvider"
      ]
    },
    "alfakit": {
      "version": "^0.1",
      "frontend": null,
      "showcase": {
        "demoPath": "house-settings",
        "tour": [
          "Open Settings > House settings",
          "Change a value",
          "Save the settings"
        ],
        "clips": [
          "react-light",
          "react-dark",
          "vue-light",
          "vue-dark",
          "svelte-light",
          "svelte-dark"
        ],
        "worksWith": [
          "shield",
          "translation-manager"
        ],
        "highlights": [
          "Settings pages for spatie/laravel-settings",
          "Any AlfaKit form field",
          "Filling and saving handled for you",
          "Per-page authorisation",
          "Register pages through the plugin"
        ]
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
